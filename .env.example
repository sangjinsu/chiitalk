# Local and Vercel Preview always default to the deterministic demo.
CHIITALK_MODE=demo
# Enable actual local provider calls only from an explicit CLI test session.
CHIITALK_ALLOW_LOCAL_LIVE=0
# Production requires all five server-only secrets. Never prefix these with NEXT_PUBLIC_.
SESSION_SECRET=
QUOTA_HMAC_SECRET=
BLOB_READ_WRITE_TOKEN=
OPENROUTER_API_KEY=
CRON_SECRET=
# Set to the exact production custom-domain origin; VERCEL_URL is also trusted.
APP_ORIGIN=
# This pinned Blob SDK reads this source-verified setting; adapter enforces zero retries.
VERCEL_BLOB_RETRIES=0
