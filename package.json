{
  "name": "chiitalk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "bun run typecheck:app && bun run typecheck:tools",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test ./tests",
    "check:live-blob": "bun scripts/check-live-blob.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "botid": "1.5.11",
    "jose": "6.2.12",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "@types/bun": "1.4.2"
  }
}
